NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10
DATABASE_SLOW_QUERY_MS=1000
DATABASE_TRANSACTION_MAX_WAIT_MS=2000
DATABASE_TRANSACTION_TIMEOUT_MS=5000
WEB_ORIGIN=https://app.example.com
API_PUBLIC_URL=https://api.example.com
SUPABASE_URL=
IMAGE_STORAGE_PROVIDER=database
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=organization-images
AUTH_SECRET=replace-with-at-least-32-random-characters
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD_HASH=replace-with-sha256-password-hash
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
VITE_API_URL=https://api.example.com
MERCADOPAGO_ACCESS_TOKEN=APP_USR_REPLACE_ME
MERCADOPAGO_WEBHOOK_SECRET=replace-me
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Turnoar <cuentas@example.com>
